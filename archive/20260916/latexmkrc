# latexmkrc — pre-updates/slides compilation config
# TEXINPUTS search order:
#   1. AN/utils/general/ — CMS logo PDFs, style files
#   2. Local utils/       — beamer_setup.tex (particle macros)
#   3. Project root (.)   — resolve relative \input paths from slides/
$ENV{'TEXINPUTS'} = '../AN/utils/general//:./utils//:./:' . ($ENV{'TEXINPUTS'} || '');
